---
import { assetPath } from '../../utils/assets';
---

<section class="proof-strip" aria-label="PokéCatch facts">
  <div class="proof-item"><strong>1,025</strong><span>species in the database</span></div>
  <div class="proof-item"><strong>7</strong><span>rarity tiers to chase</span></div>
  <div class="proof-item"><strong>15s</strong><span>between successful hunts</span></div>
  <div class="proof-item"><strong>0</strong><span>accounts or cloud sync</span></div>
</section>

<section class="type-rail page-section" aria-label="Collection data">
  <div class="type-rail-label"><span class="pixel-cursor"></span> FIELD GUIDE DATA</div>
  <div class="type-rail-items">
    <span><img src={assetPath('assets/pokemon-types/1.png')} alt="Type marker" /> 18 TYPES</span>
    <span><img src={assetPath('assets/pokemon-types/4.png')} alt="Type marker" /> 9 GENERATIONS</span>
    <span><img src={assetPath('assets/badges/1.png')} alt="Badge marker" /> ACHIEVEMENT MARK</span>
    <span class="type-rail-note">YOUR SAVE · YOUR ROUTE</span>
  </div>
</section>
